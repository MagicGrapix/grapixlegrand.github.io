flowchart LR
    accTitle: The scripted Minecraft bot interface
    accDescr: Scripted goto, equip, dig and place actions control a Minecraft character through Mineflayer. Inventory and nearby-block observations provide data back to the application. The character image is an illustration.
    subgraph A["Scripted actions"]
        direction TB
        G["goto - move"]
        E["equip - select an item"]
        D["dig - break a block"]
        P["place - place a block"]
    end
    B@{ img: "../images/minecraft-bot.png", label: "Mineflayer bot", pos: "b", h: 240, constraint: "on" }
    subgraph O["World observations"]
        direction TB
        I["Inventory"]
        N["Nearby blocks"]
        S["Position and state"]
    end
    G --> B
    E --> B
    D --> B
    P --> B
    B -.-> I
    B -.-> N
    B -.-> S
